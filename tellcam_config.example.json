{
  "pipeline": {
    "control_hz": 30,
    "detection_hz_top": 25,
    "detection_hz_side": 25,
    "preview_hz": 30,
    "show_detection_overlay": true
  },
  "cameras": {
    "index_ceiling": 0,
    "index_side": 1,
    "width": 1920,
    "height": 1080,
    "fourcc": "MJPG",
    "fps": 30,
    "exposure": -5.0,
    "buffer_size": 1,
    "drain_frames_on_read": 2
  },
  "apriltag": {
    "family": "tag36h11",
    "marker_ids": [0, 1, 2, 3, 4],
    "marker_length_m": 0.04,
    "quad_decimate": 1.0,
    "min_decision_margin": 5.0,
    "use_black_crop_fallback": false,
    "max_detection_width": 0,
    "max_markers_per_frame": 5,
    "intrinsics_from_frame_size": true
  },
  "controller": {
    "pid_x": { "kp": 60.0, "ki": 4.0, "kd": 15.0, "output_limit": 30.0 },
    "pid_y": { "kp": 60.0, "ki": 4.0, "kd": 15.0, "output_limit": 30.0 },
    "pid_z": { "kp": 80.0, "ki": 5.0, "kd": 10.0, "output_limit": 40.0 },
    "pid_yaw": { "kp": 50.0, "ki": 0.0, "kd": 5.0, "output_limit": 30.0 },
    "body_frame": true,
    "heading_offset_rad": 0.0,
    "sign_roll": 1,
    "sign_pitch": 1,
    "sign_throttle": 1,
    "sign_yaw": 1
  },
  "filter": {
    "enabled": true,
    "position_sigma_m": 0.03,
    "accel_sigma": 1.5,
    "max_predict_s": 0.4,
    "gate_m": 0.25,
    "gate_reset_count": 3,
    "confirm_count": 3,
    "use_tello_velocity": false,
    "tello_velocity_scale": 0.1,
    "tello_velocity_sigma_mps": 0.1,
    "tello_vel_sign_x": 1,
    "tello_vel_sign_y": 1
  },
  "flight": {
    "path_file": "paths/square.json",
    "takeoff_altitude_m": 1.0,
    "altitude_tolerance_m": 0.08,
    "climb_timeout_s": 12.0,
    "hover_before_path_s": 5.0,
    "altitude_source": "tello",
    "camera_height_m": 2.5,
    "hold_yaw": true,
    "yaw_source": "tello",
    "lost_tracking_land_after_s": 0.0,
    "calibrate_heading": true,
    "calib_rc": 25,
    "calib_push_s": 0.7,
    "calib_settle_s": 1.2,
    "calib_min_move_m": 0.06,
    "calib_timeout_s": 25.0
  },
  "target": { "x_m": 0.0, "y_m": 0.0, "z_m": 1.0, "yaw_rad": 0.0 },
  "failsafe": { "max_lost_frames": 15, "on_lost_send_zero_rc": true },
  "debug_windows": true,
  "control_enabled": true
}
